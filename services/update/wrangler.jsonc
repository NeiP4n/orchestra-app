{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchestra-update",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  // No Orchestra domain exists yet: the worker runs on workers.dev until the
  // project owns a domain, then add a routes entry for it (e.g.
  // update.orchestra.example) and point the audience/hostname in src/index.ts
  // and the publish URL in script/update-artifact.ts at the same domain.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orchestra-update",
      // Create a NEW database with `wrangler d1 create orchestra-update` and
      // fill in its id here. Never reuse the upstream database id.
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
