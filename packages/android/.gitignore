# Gradle
.gradle/
build/

# The Android tooling writes the machine-local SDK path here; it must never be
# committed because the path differs per build machine.
local.properties

# Signing material. The debug keystore is generated per machine and the release
# keystore is a secret; neither belongs in the repository.
*.jks
*.keystore
keystore.properties

# The web bundle is generated by scripts/build-apk.ps1 / build-apk.sh from
# packages/app/dist; committing ~35 MB of build output is not reviewable.
app/src/main/assets/app/

# Native and profiling output
.cxx/
captures/
*.hprof