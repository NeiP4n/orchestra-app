{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Sculk",
  "id": "sculk",
  "light": {
    "palette": {
      "neutral": "#e9f6f6",
      "ink": "#0c2a30",
      "primary": "#0fb5ba",
      "accent": "#6a5af0",
      "success": "#12b57a",
      "warning": "#c99a00",
      "error": "#e0394d",
      "info": "#1a8fd6",
      "interactive": "#0fb5ba",
      "diffAdd": "#4fbf9b",
      "diffDelete": "#d9475c"
    },
    "overrides": {
      "text-weak": "#5b8286",
      "syntax-comment": "#5b8286",
      "syntax-keyword": "#6a5af0",
      "syntax-string": "#12b57a",
      "syntax-primitive": "#1a8fd6",
      "syntax-variable": "#0c2a30",
      "syntax-property": "#0fb5ba",
      "syntax-type": "#b58a00",
      "syntax-constant": "#d9822b",
      "syntax-operator": "#0fb5ba",
      "syntax-punctuation": "#0c2a30",
      "syntax-object": "#0c2a30",
      "markdown-heading": "#0fb5ba",
      "markdown-text": "#0c2a30",
      "markdown-link": "#1a8fd6",
      "markdown-link-text": "#0fb5ba",
      "markdown-code": "#12b57a",
      "markdown-block-quote": "#5b8286",
      "markdown-emph": "#d9822b",
      "markdown-strong": "#b58a00",
      "markdown-horizontal-rule": "#5b8286",
      "markdown-list-item": "#1a8fd6",
      "markdown-list-enumeration": "#0fb5ba",
      "markdown-image": "#1a8fd6",
      "markdown-image-text": "#0fb5ba",
      "markdown-code-block": "#0c2a30"
    },
    "v2Overrides": {
      "v2-text-text-base": "#353535",
      "v2-text-text-muted": "#5b8286",
      "v2-text-text-faint": "#5b8286",
      "v2-background-bg-accent": "var(--v2-blue-600)",
      "v2-text-text-accent": "var(--v2-blue-600)",
      "v2-text-text-accent-hover": "var(--v2-blue-700)",
      "v2-icon-icon-accent": "var(--v2-blue-600)",
      "v2-icon-icon-accent-hover": "var(--v2-blue-700)",
      "v2-border-border-focus": "var(--v2-blue-500)"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#050f15",
      "ink": "#bff7f2",
      "primary": "#2de2e6",
      "accent": "#7b6cff",
      "success": "#3dffb0",
      "warning": "#ffd75e",
      "error": "#ff5c6a",
      "info": "#38b6ff",
      "interactive": "#2de2e6",
      "diffAdd": "#2fcf9a",
      "diffDelete": "#ff6b7d"
    },
    "overrides": {
      "text-weak": "#6fa3a6",
      "syntax-comment": "#6fa3a6",
      "syntax-keyword": "#9b8cff",
      "syntax-string": "#3dffb0",
      "syntax-primitive": "#38b6ff",
      "syntax-variable": "#bff7f2",
      "syntax-property": "#2de2e6",
      "syntax-type": "#ffd75e",
      "syntax-constant": "#ffb35c",
      "syntax-operator": "#2de2e6",
      "syntax-punctuation": "#bff7f2",
      "syntax-object": "#bff7f2",
      "markdown-heading": "#2de2e6",
      "markdown-text": "#bff7f2",
      "markdown-link": "#38b6ff",
      "markdown-link-text": "#2de2e6",
      "markdown-code": "#3dffb0",
      "markdown-block-quote": "#6fa3a6",
      "markdown-emph": "#ffb35c",
      "markdown-strong": "#ffd75e",
      "markdown-horizontal-rule": "#6fa3a6",
      "markdown-list-item": "#38b6ff",
      "markdown-list-enumeration": "#2de2e6",
      "markdown-image": "#38b6ff",
      "markdown-image-text": "#2de2e6",
      "markdown-code-block": "#bff7f2"
    },
    "v2Overrides": {
      "v2-text-text-base": "#d6f3f1",
      "v2-text-text-muted": "#6fa3a6",
      "v2-text-text-faint": "#6fa3a6",
      "v2-background-bg-accent": "var(--v2-blue-600)",
      "v2-text-text-accent": "var(--v2-blue-400)",
      "v2-text-text-accent-hover": "var(--v2-blue-300)",
      "v2-icon-icon-accent": "var(--v2-blue-400)",
      "v2-icon-icon-accent-hover": "var(--v2-blue-300)",
      "v2-border-border-focus": "var(--v2-blue-500)"
    }
  }
}