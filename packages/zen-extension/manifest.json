{
  "manifest_version": 3,
  "name": "Orchestra Companion for Zen",
  "version": "1.0.0",
  "description": "AI companion, sidebar panel and context capture for Zen Browser",
  "browser_specific_settings": {
    "gecko": {
      "id": "orchestra-zen@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Orchestra",
    "default_icon": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Orchestra Quick Action",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
